# ==============================================================================
# Gitignore for the YexcphPP project
# ==============================================================================

# --- Output Files and Directories ---
# Ignore all binary .dat files generated by the workflow.
*.dat
# Ignore the entire directory for calculation outputs.
/calculation_output/
# Ignore log files.
*.log

# --- Python Artifacts ---
# Ignore Python bytecode and cache directories.
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Virtual Environments ---
# Ignore common virtual environment directories.
.venv/
venv/
env/

# --- Dependency and Distribution Artifacts ---
# Ignore packaging and distribution build files.
*.egg-info/
dist/
build/
wheels/
*.tar.gz
*.whl

# --- Testing Artifacts ---
# Ignore pytest cache and coverage reports.
.pytest_cache/
.coverage
# Ignore the temporary directory used by the old test workflow.
/tests/test_output/

# --- Documentation to Exclude ---
# As requested, exclude the detailed workflow guide from the repository.
WORKFLOW_GUIDE.md

# --- Temporary/Diagnostic Scripts ---
# Exclude the temporary scripts we used for debugging.
diagnose_all_data.py
debug_dimensions.py
verify_setup.py

# --- System-specific files ---
# Ignore macOS-specific files.
.DS_Store

# --- IDE-specific files ---
# Ignore configuration files from common editors.
.idea/
.vscode/
